			"mob_loot_rebalance.Mob_loot_rebalance"
		],
		"client": [
			"mob_loot_rebalance.Mob_loot_rebalanceClient"
		]
	},
	"mixins": [
		"mob_loot_rebalance.mixins.json",
		{
			"config": "mob_loot_rebalance.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
