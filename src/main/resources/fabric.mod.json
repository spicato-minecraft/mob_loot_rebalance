{
	"schemaVersion": 1,
	"id": "mob_loot_rebalance",
	"version": "${version}",
	"name": "Mob Loot Rebalance",
	"description": "Elite mobs, themed vanilla loot, and optional hostile XP. Kill-method books and potions — not combat animations.",
	"authors": [
		"spicato"
	],
	"license": "CC0-1.0",
	"icon": "assets/mob_loot_rebalance/icon.png",
	"environment": "*",
	"entrypoints": {
